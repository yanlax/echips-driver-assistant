{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echips Driver Assistant",
  "version": "5.0.0",
  "identifier": "ru.echips.driverassistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Echips Driver Assistant",
        "width": 900,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
